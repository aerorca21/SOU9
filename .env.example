# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=http://localhost:3000

# PAYPAL CONFIG: Used to verify real PayPal payments server-side
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_PAYEE_EMAIL=
PAYPAL_WEBHOOK_ID=

# CLOUDFLARE CONFIG: Key used to encrypt sensitive Cloudflare settings stored in database
CLOUDFLARE_ENCRYPTION_KEY=

# REAL SMS PROVIDER (TWILIO): Credentials for high-security SMS dispatch to General Manager
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMTP MAIL SERVER CONFIGURATION: Used for sending verification emails / OTP codes
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=



